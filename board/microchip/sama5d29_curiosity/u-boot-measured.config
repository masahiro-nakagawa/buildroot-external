# v1 stack + command OFF
# CONFIG_TPM_V1 is not set
# CONFIG_TPM_TIS_SPI is not set
# CONFIG_CMD_TPM is not set

# Common deps
CONFIG_DM=y
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_CMD_SPI=y
CONFIG_ATMEL_SPI=y
CONFIG_HASH=y
CONFIG_SHA256=y
CONFIG_MICROCHIP_FLEXCOM=y
# TPM core + v2 + SPI
CONFIG_TPM=y
CONFIG_TPM_V2=y
CONFIG_TPM2_TIS_SPI=y

# Legacy measured boot (bootm path) + also measure DTB
CONFIG_MEASURED_BOOT=y
CONFIG_MEASURE_DEVICETREE=y
CONFIG_CMD_TPM_V2=y
# CONFIG_CMD_TPM is not set
CONFIG_TPM=y
CONFIG_TPM_V2=y
CONFIG_TPM2_TIS_SPI=y
CONFIG_CMD_TPM=y
CONFIG_CMD_TPM_V2=y

